# LLM provider keys for the semantic-edge pass.
# Set ONE (provider auto-detected) or set LLM_PROVIDER to choose.
# Precedence when no LLM_PROVIDER is set: anthropic > openai > gemini > openrouter.

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (GPT) — https://platform.openai.com
OPENAI_API_KEY=

# Google (Gemini) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenRouter — https://openrouter.ai (free-tier fallback path works without credits)
OPENROUTER_API_KEY=

# Optional: force a provider when multiple keys are set.
# One of: anthropic | openai | gemini | openrouter
# LLM_PROVIDER=

# Optional: override the default model for the chosen provider.
# Examples:
#   LLM_MODEL=claude-sonnet-4-5
#   LLM_MODEL=gpt-4o-mini
#   LLM_MODEL=gemini-2.0-flash
#   LLM_MODEL=anthropic/claude-sonnet-4.5  (for openrouter)
# LLM_MODEL=

# Optional: token used by some MCP servers (e.g. github). Forwarded to the server's env.
# GITHUB_TOKEN=
